# ──────────────────────────────────────────────
# DocSmith — Environment Variables
# Copy this file to .env and fill in values.
# Never commit .env to version control.
# ──────────────────────────────────────────────

# Application
NODE_ENV=development           # development | production | test
DOCSMITH_LOG_LEVEL=info        # debug | info | warn | error | silent
DOCSMITH_LOG_FORMAT=pretty     # pretty | json

# Config paths (optional overrides)
# DOCSMITH_CONFIG_PATH=./docsmith.config.ts

# Telemetry (opt-in, never enabled by default)
DOCSMITH_TELEMETRY=false

# Plugin registry (future use)
# DOCSMITH_PLUGIN_REGISTRY=https://registry.docsmith.dev
